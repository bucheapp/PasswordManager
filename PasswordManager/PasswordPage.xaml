<Page x:Class="PasswordManager.PasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="PasswordPage">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Save" Click="Save_Click"/>
                <MenuItem Header="Add AccountInfo" Click="AddAccountInfo_Click"/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="User">
                <MenuItem Header="Create User" Click="CreateUser_Click"/>
                <MenuItem Header="Select User" Click="SelectUser_Click"/>
            </MenuItem>
        </Menu>
        <Grid Background="#F4F4F4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid
            Grid.Row="0"
            >
                <TextBlock x:Name="EmptyMessage"
                   Text="data does not exist"
                   Foreground="#888"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                       />
                <ScrollViewer
                  Margin="30"
                  VerticalScrollBarVisibility="Auto">

                    <StackPanel x:Name="ServicePanel">
                        <Border
                                            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            MouseMove="Border_MouseMove"
            MouseLeftButtonUp="Border_MouseLeftButtonUp"
                                Width="{Binding ActualWidth, ElementName=MyCanvas}"
    Margin="5"
    Background="White"
    BorderBrush="#DDDDDD"
    BorderThickness="1"
    CornerRadius="10"
                                >

                            <Expander
        Header="Gmail"
        IsExpanded="False"
        Padding="10"
        Tag="1">

                                <StackPanel Margin="0,10,0,0">

                                    <!-- AccountInfoParts -->

                                    <Border
                Tag="1"
                Background="#F5F7FA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,5">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- UsernamePassword -->
                                            <TextBlock
                        Text="&#xE77B;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center" />

                                            <TextBlock
                        Grid.Column="1"
                        Text="test@gmail.com"
                        VerticalAlignment="Center" />

                                            <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                                                <!-- Copy -->
                                                <TextBlock
                            Text="&#xE8C8;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            VerticalAlignment="Center" />

                                                <!-- Edit -->
                                                <TextBlock
                            Text="&#xEB7E;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            VerticalAlignment="Center" />

                                                <!-- Delete -->
                                                <TextBlock
                            Text="&#xE74D;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Cursor="Hand"
                            VerticalAlignment="Center" />

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                    <!-- Service Buttons -->

                                    <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Left">

                                        <!-- Add -->

                                        <Button
                    Width="23"
                    Height="23"
                    Margin="5,5,0,0"
                    FontFamily="Segoe MDL2 Assets"
                    Content="&#xE710;"
                    FontSize="8"
                    Foreground="White"
                    Cursor="Hand">

                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">

                                                    <Border
                                x:Name="border"
                                Background="#FF9800"
                                CornerRadius="20">

                                                        <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                                                    </Border>

                                                    <ControlTemplate.Triggers>

                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter
                                        TargetName="border"
                                        Property="Background"
                                        Value="#F57C00" />
                                                        </Trigger>

                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter
                                        TargetName="border"
                                        Property="Background"
                                        Value="#E65100" />
                                                        </Trigger>

                                                    </ControlTemplate.Triggers>

                                                </ControlTemplate>
                                            </Button.Template>

                                        </Button>

                                        <!-- Edit -->

                                        <Button
                    Width="23"
                    Height="23"
                    Margin="5,5,0,0"
                    FontFamily="Segoe Fluent Icons"
                    Content="&#xEB7E;"
                    FontSize="10"
                    Foreground="White"
                    Cursor="Hand">

                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">

                                                    <Border
                                x:Name="border"
                                Background="#2196F3"
                                CornerRadius="20">

                                                        <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                                                    </Border>

                                                    <ControlTemplate.Triggers>

                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter
                                        TargetName="border"
                                        Property="Background"
                                        Value="#1976D2" />
                                                        </Trigger>

                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter
                                        TargetName="border"
                                        Property="Background"
                                        Value="#0D47A1" />
                                                        </Trigger>

                                                    </ControlTemplate.Triggers>

                                                </ControlTemplate>
                                            </Button.Template>

                                        </Button>

                                        <!-- Delete -->

                                        <Button
                    Width="23"
                    Height="23"
                    Margin="5,5,0,0"
                    FontFamily="Segoe Fluent Icons"
                    Content="&#xE74D;"
                    FontSize="10"
                    Foreground="White"
                    Cursor="Hand">

                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">

                                                    <Border
                                x:Name="border"
                                Background="#E53935"
                                CornerRadius="20">

                                                        <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                                                    </Border>

                                                    <ControlTemplate.Triggers>

                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter
                                        TargetName="border"
                                        Property="Background"
                                        Value="#D32F2F" />
                                                        </Trigger>

                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter
                                        TargetName="border"
                                        Property="Background"
                                        Value="#B71C1C" />
                                                        </Trigger>

                                                    </ControlTemplate.Triggers>

                                                </ControlTemplate>
                                            </Button.Template>

                                        </Button>

                                    </StackPanel>

                                </StackPanel>

                            </Expander>

                        </Border>
                    </StackPanel>

                </ScrollViewer>
            </Grid>
            <Grid Grid.Row="1"
          Height="70"
          Background="Transparent">

                <Button Width="40"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,15,0"
                FontFamily="Segoe MDL2 Assets"
                Content="&#xE710;"
                Foreground="White"
                Click="Add_Click"
                Cursor="Hand">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                            Background="#2196F3"
                            CornerRadius="20">

                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                    Property="Background"
                                    Value="#1976D2"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border"
                                    Property="Background"
                                    Value="#0D47A1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>

        </Grid>
    </DockPanel>
</Page>