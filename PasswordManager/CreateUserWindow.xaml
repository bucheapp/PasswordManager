<Window x:Class="PasswordManager.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager"
        mc:Ignorable="d"
        Title="Create User" Height="210" Width="400"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="10">

        <TextBlock Text="A new user will be created."
                   Margin="0,0,0,10"/>

        <TextBlock Text="Name:"/>
        <TextBox x:Name="NameBox" Margin="0,5,0,10"/>

        <TextBlock Text="Password:"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,5,0,10"/>

        <Button Content="OK"
                Width="80"
                HorizontalAlignment="Center"
                Click="Ok_Click"/>
    </StackPanel>
</Window>
